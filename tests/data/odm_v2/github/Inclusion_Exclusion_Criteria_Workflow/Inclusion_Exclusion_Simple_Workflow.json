                },
                {
                  "lang": "fr",
                  "Type": "text/plain",
                  "_content": "Oui"
                }
              ]
            }
          },
          {
            "CodedValue": "N",
            "Decode": {
              "TranslatedText": [
                {
                  "lang": "en",
                  "Type": "text/plain",
                  "_content": "No"
                },
                {
                  "lang": "fr",
                  "Type": "text/plain",
                  "_content": "Non"
                }
              ]
            }
          }
        ]
      }
    ],
