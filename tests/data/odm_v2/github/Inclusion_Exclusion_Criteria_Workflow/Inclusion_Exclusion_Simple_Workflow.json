          "TranslatedText": [
            {
              "lang": "en",
              "Type": "text/plain",
              "_content": "is there a diagnosis of the study disease indication (disease XYZ)?"
            }
          ]
        },
        "CodeListRef": {
          "CodeListOID": "CL.YESNO"
        }
      },
      {
        "OID": "IT.INCLUSION_2",
        "Name": "Inclusion Criterion 2",
        "DataType": "text",
        "Length": 1,
        "Question": {
          "TranslatedText": [
            {
              "lang": "en",
              "Type": "text/plain",
              "_content": "Is the subject between 18 and 65 years old?"
            }
          ]
        },
        "CodeListRef": {
          "CodeListOID": "CL.YESNO"
        }
      },
      {
        "OID": "IT.EXCLUSION_1",
