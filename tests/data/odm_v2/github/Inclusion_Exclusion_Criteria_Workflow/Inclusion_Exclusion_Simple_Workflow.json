            "SourceOID": "BR.1",
            "TargetOID": "SEG.END"
          },
          {
            "OID": "TR.INCLUSION_2_TO_STUDYEND",
            "Name": "Subject excluded from study as not meeting inclusion criterion 2",
            "SourceOID": "BR.2",
            "TargetOID": "SEG.END"
          },
          {
            "OID": "TR.EXCLUSION_1_TO_STUDYEND",
            "Name": "Subject excluded from study due to meeting exclusion criterion 1",
            "SourceOID": "BR.3",
            "TargetOID": "SEG.END"
          },
          {
            "OID": "TR.EXCLUSION_2_TO_STUDYEND",
            "Name": "Subject excluded from study due to meeting exclusion criterion 2",
            "SourceOID": "BR.4",
            "TargetOID": "SEG.END"
          }
        ],
        "Branching": [
          {
            "OID": "BR.1",
            "Name": "Evaluation of includion criterion 1",
            "Type": "Exclusive",
            "TargetTransition": [
              {
                "TargetTransitionOID": "TR.INCLUSION_1_TO_STUDYEND",
                "ConditionOID": "COND.INCL1.NOTMET"
              }
            ],
            "DefaultTransition": [
              {
                "TargetTransitionOID": "TR.2"
              }
            ]
          },
          {
            "OID": "BR.2",
            "Name": "Evaluation of includion criterion 2",
            "Type": "Exclusive",
            "TargetTransition": [
              {
                "TargetTransitionOID": "TR.INCLUSION_2_TO_STUDYEND",
                "ConditionOID": "COND.INCL2.NOTMET"
              }
            ],
            "DefaultTransition": [
              {
                "TargetTransitionOID": "TR.4"
              }
            ]
          },
          {
            "OID": "BR.3",
            "Name": "Evaluation of exclusion criterion 1",
            "Type": "Exclusive",
            "TargetTransition": [
              {
                "TargetTransitionOID": "TR.EXCLUSION_1_TO_STUDYEND",
                "ConditionOID": "COND.EXCL1.MET"
              }
            ],
            "DefaultTransition": [
              {
                "TargetTransitionOID": "TR.5"
              }
            ]
          },
          {
            "OID": "BR.4",
            "Name": "Evaluation of exclusion criterion 2",
            "Type": "Exclusive",
            "TargetTransition": [
              {
                "TargetTransitionOID": "TR.EXCLUSION_2_TO_STUDYEND",
                "ConditionOID": "COND.EXCL2.MET"
              }
            ],
            "DefaultTransition": [
              {
                "TargetTransitionOID": "SEG.SCREENING"
              }
            ]
          }
        ],
        "WorkflowEnd": [
          {
            "EndOID": "WF.END"
          }
        ]
      }
    ],
    "StudyEventGroupDef": [
