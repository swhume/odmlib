        "WorkflowStart": {
          "StartOID": "IT.INCLUSION_1"
        },
        "Transition": [
          {
            "OID": "TR.1",
            "Name": "Transition from inclusion question 1 to evaluation of inclusion question 1",
            "SourceOID": "IT.INCLUSION_1",
            "TargetOID": "BR.1"
          },
          {
            "OID": "TR.2",
            "Name": "Transition to inclusion criterion 2",
            "SourceOID": "BR.1",
            "TargetOID": "IT.INCLUSION_2"
          },
          {
            "OID": "TR.3",
            "Name": "Transition to evaluation of inclusion criterion 2",
            "SourceOID": "IT.INCLUSION_2",
            "TargetOID": "BR.2"
          },
          {
            "OID": "TR.4",
            "Name": "Transition to exlusion criterion 1",
            "SourceOID": "BR.2",
            "TargetOID": "IT.EXCLUSION_1"
          },
          {
            "OID": "TR.5",
            "Name": "Transition to evaluation of exclusion criterion 1",
            "SourceOID": "IT.EXCLUSION_1",
            "TargetOID": "BR.3"
          },
          {
            "OID": "TR.5",
            "Name": "Transition to exlusion criterion 2",
            "SourceOID": "BR.3",
            "TargetOID": "IT.EXCLUSION_2"
          },
          {
            "OID": "TR.6",
            "Name": "Transition to evaluation of exclusion criterion 2",
            "SourceOID": "IT.EXCLUSION_2",
            "TargetOID": "BR.4"
          },
          {
            "OID": "TR.INCLUSION_1_TO_STUDYEND",
