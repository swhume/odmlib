          ]
        },
        "CodeListRef": {
          "CodeListOID": "CL.YESNO"
        }
      },
      {
        "OID": "IT.EXCLUSION_2",
        "Name": "Exclusion Criterion 2",
        "DataType": "text",
        "Length": 1,
        "Question": {
          "TranslatedText": [
            {
              "lang": "en",
              "Type": "text/plain",
              "_content": "Did the subject undergo a surgical procedure in the last 12 months?"
            }
          ]
        },
        "CodeListRef": {
          "CodeListOID": "CL.YESNO"
        }
      }
    ],
    "CodeList": [
