<?xml version="1.0" encoding="UTF-8"?>
<!-- ODM v2.0 study design template (Non-normative). A two-arm, three-epoch parallel study:
     protocol summary parameters, arms and epochs, trial phase, objectives and endpoints,
     eligibility criteria backed by ConditionDefs, study cells (StudyEventGroupDefs with ArmOID and
     EpochOID) that reference study elements (StudyEventGroupDefs without them), a workflow over the
     study elements that branches by arm, and timing constraints. Replace every OID and name;
     check the C-codes against current CDISC CT. -->
<ODM xmlns="http://www.cdisc.org/ns/odm/v2.0"
     FileType="Snapshot" Granularity="Metadata" Context="Exchange" ODMVersion="2.0"
     FileOID="ODM.EXAMPLE.DESIGN.1" CreationDateTime="2026-01-01T09:00:00"
     Originator="Example Sponsor" SourceSystem="odmlib">
  <Study OID="ST.DESIGN" StudyName="DESIGN-001" ProtocolName="DESIGN-001">
    <MetaDataVersion OID="MDV.DESIGN.1" Name="Design version 1">
      <Protocol>
        <Description>
          <TranslatedText xml:lang="en" Type="text/plain">Randomized, two-arm, parallel-group study of Drug A versus placebo.</TranslatedText>
        </Description>
        <StudySummary>
          <StudyParameter OID="SP.AGEMIN" Term="Planned Minimum Age of Subjects" ShortName="AGEMIN">
            <ParameterValue Value="P18Y"/>
            <Coding Code="C49693" System="https://www.cdisc.org/standards/terminology" SystemName="CDISC/NCI CT"/>
          </StudyParameter>
          <StudyParameter OID="SP.PLANSUB" Term="Planned Number of Subjects" ShortName="PLANSUB">
            <ParameterValue Value="120"/>
            <Coding Code="C49692" System="https://www.cdisc.org/standards/terminology" SystemName="CDISC/NCI CT"/>
          </StudyParameter>
        </StudySummary>
        <StudyStructure>
          <Arm OID="ARM.A" Name="Drug A"/>
          <Arm OID="ARM.P" Name="Placebo"/>
          <Epoch OID="EP.SCREEN" Name="Screening" SequenceNumber="1"/>
          <Epoch OID="EP.TREAT" Name="Treatment" SequenceNumber="2"/>
          <Epoch OID="EP.FOLLOWUP" Name="Follow-up" SequenceNumber="3"/>
          <WorkflowRef WorkflowOID="WF.STUDY"/>
        </StudyStructure>
        <TrialPhase Value="PHASE II TRIAL"/>
        <StudyTimings>
          <StudyTiming OID="STM.MAIN" Name="Visit schedule">
            <!-- Baseline is 14 days (+/- 2 days) after the start of screening -->
            <RelativeTimingConstraint OID="RTC.SCR.BL" Name="Screening to baseline" PredecessorOID="SE.SCREENING"
                SuccessorOID="SE.BASELINE" Type="StartToStart" TimepointRelativeTarget="P14D"
                TimepointPreWindow="P2D" TimepointPostWindow="P2D"/>
            <DurationTimingConstraint OID="DTC.TREAT" Name="Treatment duration" StructuralElementOID="EP.TREAT"
                DurationTarget="P12W" DurationPreWindow="P3D" DurationPostWindow="P3D"/>
          </StudyTiming>
        </StudyTimings>
        <StudyObjectives>
          <StudyObjective OID="OBJ.1" Name="Primary efficacy objective" Level="Primary">
            <Description>
              <TranslatedText xml:lang="en" Type="text/plain">To compare the change in HbA1c from baseline to week 12 between Drug A and placebo.</TranslatedText>
            </Description>
            <StudyEndPointRef StudyEndPointOID="EPT.1"/>
          </StudyObjective>
        </StudyObjectives>
        <StudyEndPoints>
          <StudyEndPoint OID="EPT.1" Name="Change in HbA1c at week 12" Level="Primary">
            <Description>
              <TranslatedText xml:lang="en" Type="text/plain">Change from baseline in HbA1c (%) at week 12.</TranslatedText>
            </Description>
          </StudyEndPoint>
        </StudyEndPoints>
        <InclusionExclusionCriteria>
          <InclusionCriteria>
            <Criterion OID="CRIT.IN.1" Name="Adult" ConditionOID="CD.ADULT">
              <Description>
                <TranslatedText xml:lang="en" Type="text/plain">Age 18 years or older at screening.</TranslatedText>
              </Description>
            </Criterion>
          </InclusionCriteria>
          <ExclusionCriteria>
            <Criterion OID="CRIT.EX.1" Name="Pregnancy" ConditionOID="CD.PREGNANT">
              <Description>
                <TranslatedText xml:lang="en" Type="text/plain">Pregnant or breastfeeding.</TranslatedText>
              </Description>
            </Criterion>
          </ExclusionCriteria>
        </InclusionExclusionCriteria>
        <!-- The schedule: one StudyEventGroupDef per study cell (arm x epoch) -->
        <StudyEventGroupRef StudyEventGroupOID="SEG.A.SCREEN" Mandatory="No" OrderNumber="1"/>
        <StudyEventGroupRef StudyEventGroupOID="SEG.P.SCREEN" Mandatory="No" OrderNumber="2"/>
        <StudyEventGroupRef StudyEventGroupOID="SEG.A.TREAT" Mandatory="No" OrderNumber="3"/>
        <StudyEventGroupRef StudyEventGroupOID="SEG.P.TREAT" Mandatory="No" OrderNumber="4"/>
        <StudyEventGroupRef StudyEventGroupOID="SEG.A.FOLLOWUP" Mandatory="No" OrderNumber="5"/>
        <StudyEventGroupRef StudyEventGroupOID="SEG.P.FOLLOWUP" Mandatory="No" OrderNumber="6"/>
      </Protocol>
      <!-- The workflow runs over the study elements: screening, then a branch by arm, then follow-up -->
      <WorkflowDef OID="WF.STUDY" Name="Study flow">
        <WorkflowStart StartOID="SEG.E.SCREEN"/>
        <!-- A transition into a branching targets the Branching's OID; the branches start from it -->
        <Transition OID="TR.SCREEN.RAND" Name="Screening to randomization" SourceOID="SEG.E.SCREEN" TargetOID="BR.ARM"/>
        <Transition OID="TR.TO.A" Name="To Drug A treatment" SourceOID="BR.ARM" TargetOID="SEG.E.DRUGA"/>
        <Transition OID="TR.TO.P" Name="To placebo treatment" SourceOID="BR.ARM" TargetOID="SEG.E.PLACEBO"/>
        <Transition OID="TR.A.FU" Name="Drug A to follow-up" SourceOID="SEG.E.DRUGA" TargetOID="SEG.E.FOLLOWUP"/>
        <Transition OID="TR.P.FU" Name="Placebo to follow-up" SourceOID="SEG.E.PLACEBO" TargetOID="SEG.E.FOLLOWUP"/>
        <!-- Exclusive: every TargetTransition needs a ConditionDef; the DefaultTransition applies otherwise -->
        <Branching OID="BR.ARM" Name="Randomized arm" Type="Exclusive">
          <TargetTransition TargetTransitionOID="TR.TO.A" ConditionOID="CD.ARM.A"/>
          <DefaultTransition TargetTransitionOID="TR.TO.P"/>
        </Branching>
        <WorkflowEnd EndOID="SEG.E.FOLLOWUP"/>
      </WorkflowDef>
      <!-- Study cells: ArmOID and EpochOID set; each references the study element it consists of -->
      <StudyEventGroupDef OID="SEG.A.SCREEN" Name="Drug A, screening" ArmOID="ARM.A" EpochOID="EP.SCREEN">
        <StudyEventGroupRef StudyEventGroupOID="SEG.E.SCREEN" Mandatory="Yes"/>
      </StudyEventGroupDef>
      <StudyEventGroupDef OID="SEG.P.SCREEN" Name="Placebo, screening" ArmOID="ARM.P" EpochOID="EP.SCREEN">
        <StudyEventGroupRef StudyEventGroupOID="SEG.E.SCREEN" Mandatory="Yes"/>
      </StudyEventGroupDef>
      <StudyEventGroupDef OID="SEG.A.TREAT" Name="Drug A, treatment" ArmOID="ARM.A" EpochOID="EP.TREAT">
        <StudyEventGroupRef StudyEventGroupOID="SEG.E.DRUGA" Mandatory="Yes"/>
      </StudyEventGroupDef>
      <StudyEventGroupDef OID="SEG.P.TREAT" Name="Placebo, treatment" ArmOID="ARM.P" EpochOID="EP.TREAT">
        <StudyEventGroupRef StudyEventGroupOID="SEG.E.PLACEBO" Mandatory="Yes"/>
      </StudyEventGroupDef>
      <StudyEventGroupDef OID="SEG.A.FOLLOWUP" Name="Drug A, follow-up" ArmOID="ARM.A" EpochOID="EP.FOLLOWUP">
        <StudyEventGroupRef StudyEventGroupOID="SEG.E.FOLLOWUP" Mandatory="Yes"/>
      </StudyEventGroupDef>
      <StudyEventGroupDef OID="SEG.P.FOLLOWUP" Name="Placebo, follow-up" ArmOID="ARM.P" EpochOID="EP.FOLLOWUP">
        <StudyEventGroupRef StudyEventGroupOID="SEG.E.FOLLOWUP" Mandatory="Yes"/>
      </StudyEventGroupDef>
      <!-- Study elements: no ArmOID/EpochOID (they are referenced from other groups); they hold the visits -->
      <StudyEventGroupDef OID="SEG.E.SCREEN" Name="Screening element">
        <StudyEventRef StudyEventOID="SE.SCREENING" Mandatory="Yes" OrderNumber="1"/>
        <StudyEventRef StudyEventOID="SE.BASELINE" Mandatory="Yes" OrderNumber="2"/>
      </StudyEventGroupDef>
      <StudyEventGroupDef OID="SEG.E.DRUGA" Name="Drug A element">
        <StudyEventRef StudyEventOID="SE.WEEK4" Mandatory="Yes" OrderNumber="1"/>
        <StudyEventRef StudyEventOID="SE.WEEK12" Mandatory="Yes" OrderNumber="2"/>
      </StudyEventGroupDef>
      <StudyEventGroupDef OID="SEG.E.PLACEBO" Name="Placebo element">
        <StudyEventRef StudyEventOID="SE.WEEK4" Mandatory="Yes" OrderNumber="1"/>
        <StudyEventRef StudyEventOID="SE.WEEK12" Mandatory="Yes" OrderNumber="2"/>
      </StudyEventGroupDef>
      <StudyEventGroupDef OID="SEG.E.FOLLOWUP" Name="Follow-up element">
        <StudyEventRef StudyEventOID="SE.FOLLOWUP" Mandatory="Yes" OrderNumber="1"/>
      </StudyEventGroupDef>
      <StudyEventDef OID="SE.SCREENING" Name="Screening" Repeating="No" Type="Scheduled"/>
      <StudyEventDef OID="SE.BASELINE" Name="Baseline / randomization" Repeating="No" Type="Scheduled"/>
      <StudyEventDef OID="SE.WEEK4" Name="Week 4" Repeating="No" Type="Scheduled"/>
      <StudyEventDef OID="SE.WEEK12" Name="Week 12" Repeating="No" Type="Scheduled"/>
      <StudyEventDef OID="SE.FOLLOWUP" Name="Follow-up" Repeating="No" Type="Scheduled"/>
      <ConditionDef OID="CD.ADULT" Name="Age 18 or older">
        <Description>
          <TranslatedText xml:lang="en" Type="text/plain">AGE is 18 or more.</TranslatedText>
        </Description>
        <MethodSignature>
          <Parameter Name="AGE" DataType="integer"/>
          <ReturnValue Name="RESULT" DataType="boolean"/>
        </MethodSignature>
        <FormalExpression Context="Python 3">
          <Code>RESULT = AGE &gt;= 18</Code>
        </FormalExpression>
      </ConditionDef>
      <ConditionDef OID="CD.PREGNANT" Name="Pregnant or breastfeeding">
        <Description>
          <TranslatedText xml:lang="en" Type="text/plain">The subject is pregnant or breastfeeding.</TranslatedText>
        </Description>
        <MethodSignature/>
      </ConditionDef>
      <ConditionDef OID="CD.ARM.A" Name="Randomized to Drug A">
        <Description>
          <TranslatedText xml:lang="en" Type="text/plain">The randomization result is arm A.</TranslatedText>
        </Description>
        <MethodSignature/>
      </ConditionDef>
    </MetaDataVersion>
  </Study>
</ODM>
